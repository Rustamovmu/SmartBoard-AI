# npm start/start:dev/start:debug/start:prod and db:check load .env if it exists.
# Existing process environment variables take precedence.
# Preserve an existing .env; copy these settings selectively.
NODE_ENV=development
HOST=127.0.0.1
# Website development reserves 3000; its HTTPS API bridge reserves 4000.
# The source fallback remains 3000 when PORT is unset.
PORT=4001
AUTH_BROWSER_ORIGINS=https://localhost:3000
# Native transport and separate protocol-2 media bridge are both opt-in.
ANALYSIS_TRANSPORT_ENABLED=false
ANALYSIS_MEDIA_ENABLED=false
# Optional absolute isolated Python executable; default is vision/.venv/bin/python.
# VISION_PYTHON_EXECUTABLE=/absolute/path/to/vision/.venv/bin/python

# Dedicated platform database. Development also accepts the existing MONGO_DEV key.
# Production requires MONGODB_URI. URI database must be SmartBoardAI or omitted.
# Supply actual credentials only in ignored local configuration.
# MONGODB_URI=mongodb://127.0.0.1:27017/SmartBoardAI?replicaSet=rs0

# Integration/Postman commands load only this dedicated URI and generate their
# own exact sbt_<32 lowercase hex digits> database name. Omit the URI database.
# Never use development/production records or credentials as a fallback fixture.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# MONGODB_TEST_DATABASE is generated per run; manual test-mode db:check needs it.

# Never add private lecture paths, media storage, or upload destinations here.
