{
  "info": {
    "name": "SmartBoardAI — Auth v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order ONLY against npm run postman:serve. Supply its loopback baseUrl and testRunId. Uses a uniquely named disposable MongoDB test database. Credentials use runtime pm.variables only, never saved collection/environment variables. Contains no DB URI or real user credentials. Browser cookies are manually supplied on loopback for wire checks; actual browser HTTPS behavior remains a separate test."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:0"
    },
    {
      "key": "testRunId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get('baseUrl');",
          "const run = pm.variables.get('testRunId');",
          "if (!/^http:\\/\\/127\\.0\\.0\\.1:[0-9]+$/.test(base) || !/^[a-f0-9]{32}$/.test(run)) throw new Error('Use baseUrl and testRunId printed by npm run postman:serve.');",
          "if (!pm.request.url.toString().includes('/health/') && pm.variables.get('confirmedTestRun') !== run) throw new Error('Run health requests first to confirm the disposable host.');",
          "if (!pm.variables.get('fixtureEmail')) {",
          " pm.variables.set('fixtureEmail', 'postman-' + pm.variables.replaceIn('{{$guid}}') + '@example.test');",
          " pm.variables.set('fixturePassword', 'synthetic-' + pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Liveness and disposable-host confirmation",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/live",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "live"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No-store response', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
              "pm.test('Disposable test host', () => pm.expect(pm.response.headers.get('X-SmartBord-Test-Run')).to.eql(pm.variables.get('testRunId')));",
              "if (pm.response.code !== 200 || pm.response.headers.get('X-SmartBord-Test-Run') !== pm.variables.get('testRunId')) {",
              " pm.execution.setNextRequest(null); throw new Error('Refusing auth requests against an unconfirmed host.');",
              "}",
              "pm.variables.set('confirmedTestRun', pm.variables.get('testRunId'));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "response": [
        {
          "name": "Documented response shape — no credentials",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "02 Readiness with real test MongoDB",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/ready",
          "host": [
            "{{baseUrl}}"
          ],
