              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No-store response', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
              "pm.test('Disposable test host', () => pm.expect(pm.response.headers.get('X-SmartBord-Test-Run')).to.eql(pm.variables.get('testRunId')));",
              "if (pm.response.code !== 200 || pm.response.headers.get('X-SmartBord-Test-Run') !== pm.variables.get('testRunId')) {",
              " pm.execution.setNextRequest(null); throw new Error('Refusing auth requests against an unconfirmed host.');",
              "}",
              "pm.variables.set('confirmedTestRun', pm.variables.get('testRunId'));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "response": []
    },
    {
      "name": "03 Native signup creates USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-SmartBord-Client",
            "value": "native"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{fixtureEmail}}\",\n  \"name\": \"Synthetic Postman User\",\n  \"password\": \"{{fixturePassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('No-store response', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
              "pm.test('Disposable test host', () => pm.expect(pm.response.headers.get('X-SmartBord-Test-Run')).to.eql(pm.variables.get('testRunId')));",
              "const result = pm.response.json();",
              "pm.test('No password hash', () => pm.expect(result.user).not.to.have.property('passwordHash'));",
              "pm.variables.set('accessToken', result.accessToken);",
              "pm.variables.set('refreshToken', result.refreshToken);",
              "pm.test('Public signup creates USER', () => pm.expect(result.user.role).to.eql('USER'));",
              "pm.variables.set('oldAccessToken', result.accessToken); pm.variables.set('oldRefreshToken', result.refreshToken);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "response": []
    },
